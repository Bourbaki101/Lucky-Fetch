{
  "name": "luckyfetch",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A local-first, per-tab Chromium auto reloader.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/verify-build.mjs",
    "test": "vitest run",
    "lint": "eslint src tests vite.config.ts",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/chrome": "^0.0.326",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.8.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
